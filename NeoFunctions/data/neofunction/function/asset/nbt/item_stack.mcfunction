# 命名：item_stack
# 説明：アイテムのidからスタック数を返す
# 説明：入力：id:"minecraft:<アイテムのid>"
# >
# =/function neofunction:asset/nbt/item_stack

# idを取得
data remove storage neofunction:asset/nbt Temp
$data modify storage neofunction:asset/nbt Temp.in set value "$(id)"
#一旦64に
data modify storage neofunction:asset/nbt Temp.out set value 64b

#テンプレ
#execute if data storage neofunction:asset/nbt Temp{in:"minecraft:"} run data modify storage neofunction:asset/nbt Temp.out set value 1b

