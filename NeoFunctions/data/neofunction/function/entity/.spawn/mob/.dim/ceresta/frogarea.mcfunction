# 命名：frogarea
# 説明：カエルが生える
# >/function neofunction:entity/.spawn/mob
# =/function neofunction:entity/.spawn/mob/.dim/ceresta/frogarea


# ゾンビ枠：ストライカーカエル
execute as @s[type=zombie] at @s run function neofunction:asset/summon/684

# スケルトン枠：スリンガーカエル
execute as @s[type=skeleton] at @s run function neofunction:asset/summon/685

# クリーパー枠：自爆カエル
execute as @s[type=creeper] at @s run function neofunction:asset/summon/690

