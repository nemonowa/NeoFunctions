# 命名：5
# 説明：
# >world
# =/function neofunction:system/world/nexus/tutorial/5

execute align xyz positioned ~-7 ~ ~ unless entity @e[dx=11,dy=11,dz=14,tag=TutorialResolved] run fill ~6 ~ ~ ~6 ~ ~ lapis_block replace redstone_block
execute align xyz positioned ~-7 ~ ~ unless entity @e[dx=11,dy=11,dz=14,tag=TutorialResolved] run return run tellraw @a[dx=11,dy=11,dz=14] {"text": "次元アンカーを解析すると進行可能","color": "red"}
function neofunction:system/world/nexus/tutorial/.neo
place template neofunction:tutorial/6 ~-7 ~ ~
execute align xyz positioned ~-7 ~ ~ run kill @e[type=item,dx=11,dy=11,dz=14]

execute align xyz positioned ~-7 ~ ~ run advancement revoke @a[dx=11,dy=11,dz=14] only neoadvancement:nexus/root/1/7
execute align xyz positioned ~-7 ~ ~ run advancement grant @a[dx=11,dy=11,dz=14] only neoadvancement:nexus/root/1/7
execute align xyz positioned ~-7 ~ ~ run tellraw @a[dx=11,dy=11,dz=14] "§b§l条件：チュートリアル6を完了する。\n§3§l報酬：§f基礎スキル3種の解放\n§9§l説明：§7それは未知の§9金属匣体§7\n異空兵装の第二形態にして、希求力を燃料に§6ソウルの刃§7を形成する特殊な火器。§eライター§7のような形状の刀。自身の攻撃力を増幅し、攻撃した相手の§5体力を可視化§7する。\n§dシフトスキル§7でソウルを研ぎ澄まし、周囲16mのスポナーを発光させる！"
execute align xyz positioned ~-7 ~ ~ run title @a[dx=11,dy=11,dz=14] title {"text": "スキルについて","color": "blue","bold": true}
execute align xyz positioned ~-7 ~ ~ run title @a[dx=11,dy=11,dz=14] subtitle {"text": "チュートリアル6","color": "blue","bold": true}

execute align xyz positioned ~-7 ~ ~ run loot spawn ~6 ~1 ~6 loot neofunction:item/1573
execute align xyz positioned ~-7 ~ ~ run loot spawn ~6 ~1 ~6 loot neofunction:item/1574
execute align xyz positioned ~-7 ~ ~ run loot spawn ~6 ~1 ~6 loot neofunction:item/1575

execute align xyz positioned ~-7 ~ ~ positioned ~6 ~1 ~6 as @e[type=item,limit=3,sort=nearest] run data modify entity @s Motion set value [0d,0d,0d]
execute align xyz positioned ~-7 ~ ~ positioned ~6 ~1 ~6 as @e[type=item,limit=3,sort=nearest] run data modify entity @s Glowing set value 1b
execute align xyz positioned ~-7 ~ ~ positioned ~6 ~1 ~6 as @e[type=item,limit=3,sort=nearest] run data modify entity @s NoGravity set value 1b

