# 命名：錬成のトーテム 発動処理
# 説明：錬成のトーテム（ID1856 / エピック）の使用時処理。回復量を最大体力から算出して heal に渡し、追加効果を付与する
# 実行条件：used_totem 進捗の報酬として実行者（プレイヤー）に対して実行
# >/advancement neofunction:used_totem/1856
# =/function neofunction:system/adv/used_totem/1856

# 内容
# 回復量：最大体力から算出して heal へ渡す
execute store result score @s heal run attribute @s minecraft:max_health get 0.3

# 追加効果
effect give @s minecraft:regeneration 60 2 true
effect give @s minecraft:fire_resistance 60 0 true
effect give @s minecraft:absorption 60 2 true

# 再装填：使用回数を1つ減らした ID1857 に差し替えて戻す
# バニラは使った手からトーテムを消すので、空になった手へ戻す。
# オフハンド→メインハンドの順に見て、両手が埋まっていればインベントリへ。
execute if entity @s[nbt=!{Inventory:[],equipment:{offhand:{}}}] run return run item replace entity @s weapon.offhand with minecraft:totem_of_undying[minecraft:custom_model_data={floats:[1857.0f]},minecraft:custom_name=[{"text":"錬成","color":"green","bold":true,"italic":false},{"text":"のトーテム","color":"white","bold":true,"italic":false}],minecraft:lore=[{"text":"正統な複製に後付けの術式を焼き足したもの","color":"gray","italic":true},{"text":"焼き足された術式は、あと一度で焼き切れる","color":"dark_gray","italic":true},{"text":"","color":"gray","italic":false},[{"text":"▌ ","color":"green","bold":true,"italic":false},{"text":"再生能力 III","color":"blue","bold":true,"italic":false},{"text":"  (1:00)","color":"gray","italic":false}],[{"text":"▌ ","color":"green","bold":true,"italic":false},{"text":"火炎耐性","color":"blue","bold":true,"italic":false},{"text":"  (1:00)","color":"gray","italic":false}],[{"text":"▌ ","color":"green","bold":true,"italic":false},{"text":"衝撃吸収 III","color":"blue","bold":true,"italic":false},{"text":"  (1:00)","color":"gray","italic":false}],{"text":"","color":"gray","italic":false},{"text":"使用時:","color":"dark_purple","bold":true,"italic":false},[{"text":" 最大体力の ","color":"gray","italic":false},{"text":"30%","color":"aqua","bold":true,"italic":false},{"text":"を回復","color":"gray","italic":false}],[{"text":" 使用回数 ","color":"gray","italic":false},{"text":"あと1回","color":"red","bold":true,"italic":false},{"text":"で消滅","color":"gray","italic":false}],[{"text":" クールダウン ","color":"gray","italic":false},{"text":"なし","color":"green","bold":true,"italic":false}]],minecraft:custom_data={rare:["4"]}] 1
