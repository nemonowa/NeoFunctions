# 命名：原初のトーテム 発動処理
# 説明：原初のトーテム（ID1862 / ワールズ）の使用時処理。回復量を最大体力から算出して heal に渡し、追加効果を付与する
# 実行条件：used_totem 進捗の報酬として実行者（プレイヤー）に対して実行
# >/advancement neofunction:used_totem/1862
# =/function neofunction:system/adv/used_totem/1862

# 内容
# 回復量：最大体力から算出して heal へ渡す
execute store result score @s heal run attribute @s minecraft:max_health get 1

# 追加効果
effect give @s minecraft:resistance 180 4 true
effect give @s minecraft:regeneration 180 4 true
effect give @s minecraft:fire_resistance 180 0 true
effect give @s minecraft:absorption 180 4 true

# 再装填：消滅しないアイテムなので同じものを戻す
# バニラは使った手からトーテムを消すので、空になった手へ戻す。
# オフハンド→メインハンドの順に見て、両手が埋まっていればインベントリへ。
execute if entity @s[nbt=!{Inventory:[],equipment:{offhand:{}}}] run return run item replace entity @s weapon.offhand with minecraft:totem_of_undying[minecraft:custom_model_data={floats:[1862.0f]},minecraft:enchantment_glint_override=true,minecraft:custom_name=[{"text":"✦ ","color":"yellow","bold":true,"italic":false,"underlined":true},{"text":"原初","color":"yellow","bold":true,"italic":false,"underlined":true},{"text":"のトーテム","color":"gold","bold":true,"italic":false,"underlined":true},{"text":" ✦","color":"yellow","bold":true,"italic":false,"underlined":true}],minecraft:lore=[{"text":"最初に生まれた、ただ一つのトーテム","color":"yellow","bold":true,"italic":true},{"text":"他の全てはこれの影にすぎない","color":"gold","italic":true},{"text":"","color":"gray","italic":false},[{"text":"◆ ","color":"gold","bold":true,"italic":false},{"text":"耐性 V","color":"blue","bold":true,"italic":false},{"text":"  (3:00)","color":"gray","italic":false}],[{"text":"◆ ","color":"gold","bold":true,"italic":false},{"text":"再生能力 V","color":"blue","bold":true,"italic":false},{"text":"  (3:00)","color":"gray","italic":false}],[{"text":"◆ ","color":"gold","bold":true,"italic":false},{"text":"火炎耐性","color":"blue","bold":true,"italic":false},{"text":"  (3:00)","color":"gray","italic":false}],[{"text":"◆ ","color":"gold","bold":true,"italic":false},{"text":"衝撃吸収 V","color":"blue","bold":true,"italic":false},{"text":"  (3:00)","color":"gray","italic":false}],{"text":"","color":"gray","italic":false},{"text":"◆ 使用時","color":"dark_purple","bold":true,"italic":false},{"text":" 体力を全回復","color":"aqua","bold":true,"italic":false},[{"text":" 使用回数 ","color":"gray","italic":false},{"text":"無限","color":"green","bold":true,"italic":false}],[{"text":" クールダウン ","color":"gray","italic":false},{"text":"なし","color":"green","bold":true,"italic":false}],{"text":"それでも、奈落は待っている","color":"dark_gray","bold":true,"italic":true}],minecraft:tooltip_display={hidden_components:["minecraft:enchantments"]},minecraft:custom_data={rare:["9"]}] 1
