# 命名：残響のトーテム 発動処理
# 説明：残響のトーテム（ID1858 / スーパーレア）の使用時処理。回復量を最大体力から算出して heal に渡し、追加効果を付与する
# 実行条件：used_totem 進捗の報酬として実行者（プレイヤー）に対して実行
# >/advancement neofunction:used_totem/1858
# =/function neofunction:system/adv/used_totem/1858

# 内容
# 回復量：最大体力から算出して heal へ渡す
execute store result score @s heal run attribute @s minecraft:max_health get 0.4

# 追加効果
effect give @s minecraft:regeneration 90 2 true
effect give @s minecraft:fire_resistance 90 0 true
effect give @s minecraft:absorption 90 3 true

# 再装填：消滅しないアイテムなので同じものを戻す
# バニラは使った手からトーテムを消すので、空になった手へ戻す。
# オフハンド→メインハンドの順に見て、両手が埋まっていればインベントリへ。
execute if entity @s[nbt=!{Inventory:[],equipment:{offhand:{}}}] run return run item replace entity @s weapon.offhand with minecraft:totem_of_undying[minecraft:custom_model_data={floats:[1858.0f]},minecraft:custom_name=[{"text":"残響","color":"aqua","bold":true,"italic":false},{"text":"のトーテム","color":"white","bold":true,"italic":false}],minecraft:lore=[{"text":"原初の響きをわずかに写し取った複製","color":"gray","italic":true},{"text":"摩耗はする。だが壊れはしない","color":"dark_gray","italic":true},{"text":"","color":"gray","italic":false},[{"text":"▌ ","color":"aqua","bold":true,"italic":false},{"text":"再生能力 III","color":"blue","bold":true,"italic":false},{"text":"  (1:30)","color":"gray","italic":false}],[{"text":"▌ ","color":"aqua","bold":true,"italic":false},{"text":"火炎耐性","color":"blue","bold":true,"italic":false},{"text":"  (1:30)","color":"gray","italic":false}],[{"text":"▌ ","color":"aqua","bold":true,"italic":false},{"text":"衝撃吸収 IV","color":"blue","bold":true,"italic":false},{"text":"  (1:30)","color":"gray","italic":false}],{"text":"","color":"gray","italic":false},{"text":"使用時:","color":"dark_purple","bold":true,"italic":false},[{"text":" 最大体力の ","color":"gray","italic":false},{"text":"40%","color":"aqua","bold":true,"italic":false},{"text":"を回復","color":"gray","italic":false}],[{"text":" 使用回数 ","color":"gray","italic":false},{"text":"無限","color":"green","bold":true,"italic":false}],[{"text":" クールダウン ","color":"gray","italic":false},{"text":"5:00","color":"yellow","bold":true,"italic":false}],[{"text":" クールダウン中の使用は ","color":"gray","italic":false},{"text":"砕けて消滅","color":"red","bold":true,"italic":false},{"text":"、効果も不発","color":"gray","italic":false}]],minecraft:custom_data={rare:["5"]}] 1
