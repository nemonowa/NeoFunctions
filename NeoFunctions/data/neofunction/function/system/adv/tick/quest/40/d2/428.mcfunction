# 命名：428
# 説明：【追加：2026-10-09 ルブラ編】番人を倒したあと、セレンと向き合う：星は生きている、ルブラは星の名前、虚の海と星を削ってきた街（秘密 1・2）、星を還すという目的。最後に選択 B（チャット）
# 実行条件：実行位置 番人の間の中心。#temp main_story 427
# >/function neofunction:entity/skill/boss/rubra_keeper/dead
# >/function neofunction:entity/skill/boss/rubra_keeper/defeated
# =/function neofunction:system/adv/tick/quest/40/d2/428

# 内容
execute unless score #temp main_story matches 427 run return 0
scoreboard players set #temp main_story 428
# セレン（見た目だけのマネキン）が奥の祠の入口に立っている
execute as @e[type=marker,tag=rubra_selen_spot,limit=1] at @s run summon mannequin ~ ~ ~ {Rotation:[0.0f,0.0f],Invulnerable:1b,Silent:1b,Tags:["rubra_selen","rubra_d2"],hide_description:1b,immovable:1b,equipment:{chest:{id:"minecraft:leather_chestplate",count:1,components:{"minecraft:dyed_color":3487029}},legs:{id:"minecraft:leather_leggings",count:1,components:{"minecraft:dyed_color":3487029}},feet:{id:"minecraft:leather_boots",count:1,components:{"minecraft:dyed_color":3487029}}}}
data modify storage neofunction:rubra talk set value [{Text:{text:"拍手が聞こえた。ぱち、ぱち、と、ゆっくりした拍手。奥の祠の入口に、外套の人物が立っている。仮面は、つけていなかった。",color:"gray",italic:true},Delay:120,Sound:{Sound:"minecraft:entity.player.attack.nodamage",Pitch:0.6}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「……強くなったわね、ミラ」"}]},Delay:80,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.4}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「師匠……。あの壁画、嘘ですよね。星は、落ちてきたんですよね。誰かが引きずり下ろしたなんて――」"}]},Delay:110,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.5}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「嘘じゃないわ。星は、生きている。あなたが夢の中で聞いた声。あれは、星の声。何百年も前、この空を泳いでいた、星の子どもの声よ」"}]},Delay:150,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.3}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「その星の名前を、教えてあげましょうか。……ルブラ。わたしたちの街の名前は、わたしたちが閉じこめた、星の名前なの」"}]},Delay:150,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.2}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「ルブラの下には、黒い海がある。底のない、何もかもを呑みこむ海。虚の海。星の光は、その黒い水を清めて、泉にして地上へ湧かせているの。ルブラの水は、星の体を通ってきた水。だから、こんなにも甘い」"}]},Delay:170,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.2}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「そして、わたしたちは何百年も、その星の体を掘ってきた。星核と呼んで。星鉄と呼んで。……坑道で聞いた『いたい』という声は、蟲に食われる痛みだけじゃない。わたしたちに削られる、何百年分の痛みよ」"}]},Delay:170,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.2}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「だから、返すの。星の欠片を集めて、星を目覚めさせる。目覚めた星は、自分の力で空へ還る。……それが、わたしのやろうとしていること」"}]},Delay:140,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.3}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「でも、星が還ったら、泉は――」"}]},Delay:70,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.5}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「涸れるでしょうね。……それでも、誰かを生け贄にして湧く水を、あなたはこれからも、甘いと思って飲める？」"}]},Delay:20,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.1},Command:"function neofunction:system/adv/tick/quest/40/d2/choice_b_show"}]
function neofunction:system/adv/tick/quest/40/d1/talk
