data modify storage neofunction:rubra talk set value [{Text:{text:""},Delay:20,Sound:{Sound:"minecraft:block.note_block.bell",Pitch:1.2}},{Text:{text:"",extra:[{text:"<"},{text:"バルド",color:"#C9784A",bold:true},{text:"> 「おお、星読みの嬢ちゃんか。……そっちは、ゆうべの騒ぎの客人だな」"}]},Delay:100,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.8}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「鉱夫頭のバルドさんです。ルブラでいちばん、坑道に詳しい人」"}]},Delay:90,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.6}},{Text:{text:"",extra:[{text:"<"},{text:"バルド",color:"#C9784A",bold:true},{text:"> 「いちばん長く潜ってるってだけさ。……足跡なら、入口から奥へ続いてる。鉱夫の靴じゃねえ。もっと軽い」"}]},Delay:110,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.8}},{Text:{text:"",extra:[{text:"<"},{text:"バルド",color:"#C9784A",bold:true},{text:"> 「それに、土がほんのかすかに赤く光ってやがる。星核の粉だ。こぼしながら歩いてやがる」"}]},Delay:110,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.8}},{Text:{text:"",extra:[{text:"<"},{text:"バルド",color:"#C9784A",bold:true},{text:"> 「……それとな。近ごろ、深い層で妙な音がするんだ。風じゃねえ。水でもねえ」"}]},Delay:110,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.8}},{Text:{text:"",extra:[{text:"<"},{text:"バルド",color:"#C9784A",bold:true},{text:"> 「子守唄だな。誰かが、誰かを寝かしつけてるみてえな。若い連中は気味悪がって、三の層より下には行きたがらねえ」"}]},Delay:130,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.8}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「灯りは、角灯じゃなくて、こっちを使ってください。星核の、ちいさな欠片です」"}]},Delay:100,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.6}},{Text:{text:"ミラから星核の欠片を 4 つ受け取った。（オフハンドに持つと、深い層の暗闇を照らす）",color:"#FF8A7A",italic:true},Delay:90,Sound:{Sound:"minecraft:entity.item.pickup",Pitch:0.8},Command:"function neofunction:system/adv/tick/quest/40/d1/give_fragments"},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「師匠が言ってました。坑道の深いところでは、火は消えるけど、星の光は消えないって」"}]},Delay:110,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.6}},{Text:{text:"",extra:[{text:"<"},{text:"バルド",color:"#C9784A",bold:true},{text:"> 「……セレンの嬢ちゃんが、そんなことを。あいつはよくここへ来てたよ。いなくなる前の月には、毎日な」"}]},Delay:120,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.8}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「……わたし、先に三の層まで降りて待ってます。旅人さんは、足跡をたどってきてください」"}]},Delay:60,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.6},Command:"function neofunction:system/adv/tick/quest/40/d1/411"}]
