# 命名：442
# 説明：【追加：2026-10-09 ルブラ編】星還祭の夜、星の広場：オルドが民に頭を下げる。手記を広場で明かしていれば（choice.reveal）、人々は灯籠を掲げて支えてくれる。伏せていれば、人々は何も知らないまま祭りを始める。【変更：2026-10-13】夜だけ始まる（904 で night_time を見る）。灯籠に火がともる語りで、灯籠が夜空へ昇っていく（system/rubra/fin/skylantern_start）
# 実行条件：実行者 オルド（村人 904）。#temp main_story 441、夜（neofunction:night_time）
# >/function neofunction:system/adv/player_interacted_with_entity/villager/904
# =/function neofunction:system/adv/tick/quest/40/fin/442

# 内容
execute unless score #temp main_story matches 441 run return 0
scoreboard players set #temp main_story 442
execute if data storage neofunction:rubra choice{reveal:"reveal"} run data modify storage neofunction:rubra talk set value [{Text:{text:"星還祭の夜。泉は細く、川は黒いまま。それでも星の広場には、街じゅうの人々が、灯籠を手に集まっていた。",color:"gray",italic:true},Delay:110,Sound:{Sound:"minecraft:block.note_block.chime",Pitch:0.6}},{Text:{text:"",extra:[{text:"<"},{text:"オルド",color:"#4A7BD0",bold:true},{text:"> 「民よ。今宵、我らは、何百年前の約束を果たす。星を、空へ還す」"}]},Delay:110,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.6}},{Text:{text:"",extra:[{text:"<"},{text:"オルド",color:"#4A7BD0",bold:true},{text:"> 「そのあと泉がどうなるか、わしにもわからぬ。……長いあいだ、黙っていて、すまなかった」"}]},Delay:110,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.6}},{Text:{text:"広場は静かだった。誰かが、灯籠に火をともした。ひとつ。ふたつ。それから、次々と。",color:"gray",italic:true},Delay:100,Sound:{Sound:"minecraft:item.flintandsteel.use",Pitch:1.0},Command:"function neofunction:system/rubra/fin/skylantern_start"},{Text:{text:"",extra:[{text:"<"},{text:"バルド",color:"#B5651D",bold:true},{text:"> 「何を謝ってやがる、爺さま。祭りだぞ。始めようぜ」"}]},Delay:90,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.8}},{Text:{text:"",extra:[{text:"<"},{text:"カシム",color:"#E0A040",bold:true},{text:"> 「水が足りなきゃ、分ければいい。隊商はずっとそうしてきたさ」"}]},Delay:90,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.1}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「……塔へ。楔は、わたしが抜く。旅人さん、ミラ、ついてきて」"}]},Delay:20,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.0},Command:"function neofunction:system/adv/tick/quest/40/fin/442_end"}]
execute unless data storage neofunction:rubra choice{reveal:"reveal"} run data modify storage neofunction:rubra talk set value [{Text:{text:"星還祭の夜。泉は細く、川は黒いまま。何も知らない人々が、いつもの祭りのように、広場に灯籠を並べている。",color:"gray",italic:true},Delay:110,Sound:{Sound:"minecraft:block.note_block.chime",Pitch:0.6}},{Text:{text:"",extra:[{text:"<"},{text:"オルド",color:"#4A7BD0",bold:true},{text:"> 「……祭りを、始めよう」"}]},Delay:90,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.6}},{Text:{text:"オルドは、それ以上、何も言わなかった。灯籠の火は、ぽつり、ぽつりと、まばらに灯った。",color:"gray",italic:true},Delay:100,Sound:{Sound:"minecraft:item.flintandsteel.use",Pitch:0.8},Command:"function neofunction:system/rubra/fin/skylantern_start"},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「（……みんな、何も知らないまま。わたしたちだけで、やるしかない）」"}]},Delay:90,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.4}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「……塔へ。楔は、わたしが抜く。旅人さん、ミラ、ついてきて」"}]},Delay:20,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.0},Command:"function neofunction:system/adv/tick/quest/40/fin/442_end"}]
function neofunction:system/adv/tick/quest/40/d1/talk
