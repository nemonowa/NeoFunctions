# 命名：416
# 説明：ソウルイーターを倒したあと：星の血晶、星の声「ありがとう」、底なしの穴、セレンの背中。最後に欠片の選択を出す
# 実行条件：実行位置 蟲が崩れた所。#temp main_story 415
# >/function neofunction:entity/skill/boss/rubra_worm/dead
# >/function neofunction:entity/skill/boss/rubra_worm/defeated
# =/function neofunction:system/adv/tick/quest/40/d1/416

# 内容
execute unless score #temp main_story matches 415 run return 0
scoreboard players set #temp main_story 416
data modify storage neofunction:rubra talk set value [{Text:{text:"蟲の巨体が、黒い砂になって崩れていく。赤い光に触れた砂は、じゅっと音を立てて消えた。この場所にいてはいけないものだったかのように。",color:"gray",italic:true},Delay:120,Sound:{Sound:"minecraft:block.sand.break",Pitch:0.5}},{Text:{text:"崩れた砂の中に、血のように赤い、涙のかたちの結晶がひとつだけ残った。",color:"gray",italic:true},Delay:100,Sound:{Sound:"minecraft:block.amethyst_block.chime",Pitch:0.6}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「星の……血晶。院の書物で、絵だけ見たことがある。星が傷ついたときに流れる血が、固まったもの、って……」"}]},Delay:120,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.5}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「待って。じゃあ、あの蟲は、星を――」"}]},Delay:70,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.7}},{Text:{text:"――ありがとう。",color:"#FF8A7A",bold:true,italic:true},Delay:90,Sound:{Sound:"minecraft:entity.allay.ambient_with_item",Pitch:0.6}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「……聞こえ、ましたか」"}]},Delay:80,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.5}},{Text:{text:"蟲が這い出してきた真ん中の穴は、底が見えない。のぞきこむと、はるか下で、黒いものがぬらりとうねった。水のような。けれど、水ではない何か。",color:"gray",italic:true},Delay:120,Sound:{Sound:"minecraft:ambient.cave",Pitch:0.6}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「あの蟲……下から来た？　この下には、何もないはずなのに。ここが、ルブラのいちばん深いところで――」"}]},Delay:100,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.5}},{Text:{text:"空洞の奥で、小石が転がる音がした。",color:"gray",italic:true},Delay:70,Sound:{Sound:"minecraft:block.gravel.fall",Pitch:0.8},Command:"function neofunction:system/adv/tick/quest/40/d1/selen"},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「――師匠！　待って、師匠っ！」"}]},Delay:110,Sound:{Sound:"minecraft:entity.villager.hurt",Pitch:1.6}},{Text:{text:"外套の背中は振り返らなかった。ほんのわずかに足を止めて、それから西の狭い横穴へ消えた。横穴が、崩れ落ちる。",color:"gray",italic:true},Delay:110,Sound:{Sound:"minecraft:block.gravel.break",Pitch:0.6}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「……どうして。どうして、逃げるの」"}]},Delay:110,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.3}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「……旅人さん。残った星核の花、どうしましょう。鉱夫さんたちに持ち帰れば、きっと喜びます。でも……ここは、星の畑だから」"}]},Delay:120,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.5}},{Text:{text:"【選ぶ】チャットの［埋め戻す］か［持ち帰る］をクリックして選ぶ。（あとからでも、ミラに話しかけるともう一度出る）",color:"#FFD27A",italic:true},Delay:20,Sound:{Sound:"minecraft:block.note_block.bell",Pitch:1.0},Command:"function neofunction:system/adv/tick/quest/40/d1/choice_show"}]
function neofunction:system/adv/tick/quest/40/d1/talk
