# 命名：30
# 説明：（説明未記載）
# >/このファンクションはfunction neofunction:system/adv/tick/quest/30/numberまたは汎用会話モジュールのCommandから叩かれています。ご確認ください。
# =/function neofunction:system/adv/tick/quest/30/tellraw/30



data modify storage neofunction:main_story Talks set value [{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「あなたが、カエルの被害から黄金麦を救ってくれた、異邦人かしら。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「ここに来たのも商会長さんの紹介でしょう？」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「そうでしたら、この話をしようかしら。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「この島ではね、『セレスタフェスタ』という祝祭があるの。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「豊穣を祝い、この地へ流れ着いた異邦人を迎え、そして旅立つ魂を見送る。この島で最も神聖な祝祭よ。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「でも、それはただのお祭りじゃない。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「セレスタフェスタは、この島の生命を巡らせるための儀式なの。大地も、森も、動物も、人も……すべての命は、この祝祭によって次の季節へと繋がっていく。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「祝祭が執り行われる夜には、天地が鳴動し、木々は歌い、風は踊る。それは女神セレスタが、すべての命を祝福してくださる証だと伝えられているわ。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「だけどね……もし祝祭が成就しなければ、この島の命は閉ざされた円環の中を彷徨い、やがて静かに消えてしまう。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「だから、この島に生きる者は誰一人として手を抜かない。子どもも、大人も、旅人も、精霊も、獣たちでさえ、それぞれのやり方で命を見送ろうとする。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「それが、この島で生きるということ。そして、女神セレスタへ捧げる、何より大切な祈りなのよ。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「祝祭のブーケは、その年にこの島へ流れ着いた異邦人にしか摘み取ることができないの。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「そして祝祭を迎えるためには、島の各地に受け継がれてきた七つのクリスタルを集め、女神の神殿『パレス・オブ・セレスタ』へ奉納しなければならないわ。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「クリスタルは、ただの宝石ではない。それぞれの町の命ともいえる、人々の願いと、女神セレスタの加護が宿る祈りの結晶なの。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「だから、このクリスタルは誰にでも託されるものではない。今年の祝祭を託してもよい――そう信じられた異邦人だけが受け取ることを許されるのよ。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「あなたはもう、ビリーの野営地とシエラの碧天牧場を巡り、それぞれのクリスタルを受け取ってきたわね。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「そして今、この黄金穀倉ルクスイーファのクリスタルも、あなたに託しましょう。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2},Command:"function neofunction:system/adv/tick/quest/30/tellraw/31"},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「どうか大切に持っていって。七つのクリスタルが揃ったとき、あなたは祝祭のブーケを摘み取る資格を得るでしょう。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「でも、クリスタルを集めることだけが旅ではないわ。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「この先も、あなたはたくさんの町や村を巡ることになる。そこには、それぞれの暮らしがあり、人々の願いがあり、長い年月をかけて守られてきた歴史がある。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「そのすべてを、この目で見て、この心で感じておきなさい。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「そして旅の果てに、あなた自身の『護りたいもの』を見つけるの。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「その想いこそが、祝祭のブーケを咲かせ、セレスタフェスタを成功へ導く、何より大切な力になるのだから。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「セレスタ様は、いつも私たちを見守ってくださっているわ。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「あなたの冒険に、女神の祝福がありますように。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2}},{Text:'[{"text":"<"},{"selector":"@e[nbt={DeathLootTable:\\"neofunction:asset/summon/764\\"},limit=1]"},{"text":">"},{"text":"「黄金穀倉ルクスイーファを代表して、この言葉を贈らせていただくわ。」"}]',Sound:{Sound:"entity.villager.yes",Pitch:1.2},Command:"schedule function neofunction:system/adv/tick/quest/30/tellraw/32 5s"}]
execute as @a at @s run function neofunction:asset/event/talk/.neo {Path:"neofunction:main_story Talks"} 



