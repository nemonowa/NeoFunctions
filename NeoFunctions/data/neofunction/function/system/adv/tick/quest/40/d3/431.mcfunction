# 内容
execute unless score #temp main_story matches 430 run return 0
scoreboard players set #temp main_story 431
data modify storage neofunction:rubra talk set value [{Text:{text:"オルドは長いこと、窓の外の黒い川を見ていた。それから書棚の奥から、水守頭の印のついた小さな鉄の箱を取り出した。",color:"gray",italic:true},Delay:120,Sound:{Sound:"minecraft:block.iron_trapdoor.open",Pitch:0.6}},{Text:{text:"",extra:[{text:"<"},{text:"オルド",color:"#4A7BD0",bold:true},{text:"> 「初代水守、アズールの手記だ。代々の水守頭だけが読むことを許されている。……そなたらに、これを読ませる」"}]},Delay:130,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.6}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「オルドさま、それは掟が――」"}]},Delay:60,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.6}},{Text:{text:"",extra:[{text:"<"},{text:"オルド",color:"#4A7BD0",bold:true},{text:"> 「掟は、街を守るためにある。街を守れなくなった掟に、何の意味がある」"}]},Delay:110,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.6},Command:"function neofunction:system/adv/tick/quest/40/d3/give_journals"},{Text:{text:"アズールの手記 その五・その六・その七 を受け取った。（天墜。鎖の要の楔。年に一度、灯を空へ放て。……私たちは、借りているのだ）",color:"#C9A27E",italic:true},Delay:140,Sound:{Sound:"minecraft:item.book.page_turn",Pitch:0.8}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「……約束、だったんだ。星還祭は、お礼なんかじゃなかった。いつか必ず還すって、忘れないための……」"}]},Delay:140,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.3}},{Text:{text:"",extra:[{text:"<"},{text:"オルド",color:"#4A7BD0",bold:true},{text:"> 「忘れたのだ。三代目が、この手記を箱に封じた。星を還せば水が涸れ、千の民が砂漠に放り出される。……三代目は、約束を子らに伝えないことを選んだ。そして代々の水守頭は、知ったうえで黙ってきた。わしもだ」"}]},Delay:170,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.6},Command:"function neofunction:system/adv/tick/quest/40/d3/431_ordo"},{Text:{text:"",extra:[{text:"<"},{text:"オルド",color:"#4A7BD0",bold:true},{text:"> 「セレンがやろうとしていることは、正しい。だが、やり方を間違えている。半ば眠った星を無理に起こせば、星は目覚める前に、虚の海に呑まれる。……楔は、塔の真下にある。零の揺籃と、古い民が呼んだ場所だ」"}]},Delay:170,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.6}},{Text:{text:"",extra:[{text:"<"},{text:"オルド",color:"#4A7BD0",bold:true},{text:"> 「……民に、話すべきか。わしには、もう決められん。客人、そなたはどう思う」"}]},Delay:20,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:0.6},Command:"function neofunction:system/adv/tick/quest/40/d3/choice_c_show"}]
function neofunction:system/adv/tick/quest/40/d1/talk
