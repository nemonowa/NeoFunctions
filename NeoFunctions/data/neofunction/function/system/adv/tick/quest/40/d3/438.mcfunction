# 眠るセレン（見た目だけのマネキン）
summon mannequin ~ ~ ~2 {Invulnerable:1b,Silent:1b,Tags:["rubra_selen_sleep","rubra_d3"],hide_description:1b,immovable:1b,pose:"sleeping",equipment:{chest:{id:"minecraft:leather_chestplate",count:1,components:{"minecraft:dyed_color":3487029}},legs:{id:"minecraft:leather_leggings",count:1,components:{"minecraft:dyed_color":3487029}}}}
data modify storage neofunction:rubra talk set value [{Text:{text:"最後の欠片が離れたとき、広間じゅうの影が、ふっとかき消えた。セレンは、ミラの腕の中で目を開けた。今度は、ちゃんとミラを見ていた。",color:"gray",italic:true},Delay:140,Sound:{Sound:"minecraft:block.beacon.deactivate",Pitch:1.2}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「……ミラ。わたし、間違えたのね。星の声だと思ってた。でも途中から、わからなくなった。星が早く起こしてって言ってるのか、それとも――もっと別の何かが、早くふたを開けてって言ってるのか」"}]},Delay:170,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.3},Command:"function neofunction:system/adv/tick/quest/40/d3/438_way"},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「アズールの手記を、わたしは十年前に盗み読みしたの。そのときからずっと、星を還したかった。でも弓が打てなかった。……星が泣いてるのに、待てなかった」"}]},Delay:160,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.2}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「師匠は、悪くない」"}]},Delay:70,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.4}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「悪いわよ。あなたを置いていった。それがいちばん、悪い」"}]},Delay:110,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.3}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「あれが天墜の楔。星をつないでいる鎖の要。……抜きはしないわ。頭を、ほんの少し欠けさせるだけ。星を地上につなぐ力は、星を空へ送る力にもなる。星を傷つけずに送る弓には、楔そのものが要るの」"}]},Delay:170,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.2}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「ルブラ。ごめんなさい。もう少しだけ、待ってて」"}]},Delay:90,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.4}},{Text:{text:"ぴしり、と小さな音がした。楔の頭が指の先ほど欠けて、セレンの手のひらに落ちた。金色の、小さな、星の形をしたかけら。",color:"gray",italic:true},Delay:120,Sound:{Sound:"minecraft:block.amethyst_block.break",Pitch:1.4}},{Text:{text:"――……うん。",color:"#FF8A7A",italic:true},Delay:80,Sound:{Sound:"minecraft:entity.allay.ambient_with_item",Pitch:0.6},Command:"function neofunction:system/adv/tick/quest/40/d3/give_wedge"},{Text:{text:"「天墜の楔」を受け取った。",color:"#F2C94C",bold:true},Delay:80,Sound:{Sound:"minecraft:entity.player.levelup",Pitch:0.8}},{Text:{text:"",extra:[{text:"<"},{text:"セレン",color:"#C8D0FF",bold:true},{text:"> 「星を傷つけずに送る弓。それを打てるのは、ルブラにはひとりしかいない。……ごめん。少し、眠らせて。十年分、疲れたの」"}]},Delay:140,Sound:{Sound:"minecraft:entity.allay.ambient_without_item",Pitch:1.2}},{Text:{text:"",extra:[{text:"<"},{text:"ミラ",color:"#7FB3FF",bold:true},{text:"> 「……帰りましょう、旅人さん。祭りの準備、しなきゃ」"}]},Delay:20,Sound:{Sound:"minecraft:entity.villager.ambient",Pitch:1.4},Command:"function neofunction:system/adv/tick/quest/40/d3/439"}]
function neofunction:system/adv/tick/quest/40/d1/talk
