# 命名：view
# 説明：（説明未記載）
# >/function neofunction:system/adv/tick/cmd/1717/.neo
# =/function neofunction:system/adv/tick/cmd/1717/editor/view

playsound minecraft:block.amethyst_cluster.break record @s ~ ~ ~ 1 1.5 1
playsound minecraft:entity.arrow.hit_player record @s ~ ~ ~ 1 2 1
particle minecraft:enchant ~ ~1.2 ~ 0.5 0.5 0.5 0.1 333 force

tellraw @s {"text": "Code-----------------"}
# 準備
summon item_display ~ ~ ~ {view_range:0,Tags:["resolve","del"]}
loot replace entity @e[tag=resolve,limit=1,sort=nearest] container.0 loot neofunction:player_head
function neofunction:system/adv/tick/cmd/1717/editor/get_data with entity @e[tag=resolve,limit=1,sort=nearest] item.components."minecraft:profile"
# For文の準備
data remove storage neofunction:item/1717 For
data modify storage neofunction:item/1717 For.Function set value "neofunction:system/adv/tick/cmd/1717/editor/for"
data modify storage neofunction:item/1717 For.List set from storage neofunction:item/1717 data.List
# 文字結合の準備
summon text_display ~ ~ ~ {view_range:0,Tags:["concat","del"],alignment:"center",text:{"text": ""}}
# カーソル位置の準備
execute store result score #Calc1 temp run data get storage neofunction:item/1717 data.Cursor
# 【変更：2026-09-28 26.3対応】名前・説明文・文字表示の中身は 1.21.5 から JSON の文字列ではなく文章の部品として読まれる。文字列のままだと {"text":…} がそのまま表示されるため、部品の形（引用符なし）に直す
execute if score #Calc1 temp matches 0 run data modify entity @e[tag=concat,limit=1,sort=nearest] text set value {"text":"|"}
scoreboard players set #Calc2 temp 0
# For文実行
function neofunction:asset/nbt/for with storage neofunction:item/1717 For
tellraw @s {"entity": "@e[tag=concat,limit=1,sort=nearest]","nbt": "text","interpret": true}
kill @e[tag=concat,limit=1,sort=nearest]
kill @e[tag=resolve,limit=1,sort=nearest]
tellraw @s {"text": "Edit-----------------"}

