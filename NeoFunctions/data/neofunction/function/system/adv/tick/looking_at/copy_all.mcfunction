# 命名：copy_all
# 説明：
# >/function neofunction:tick/looking_at/copy_all
# =/function neofunction:system/adv/tick/looking_at/copy_all



## 内容
item replace entity @e[tag=copy_all] weapon.mainhand from entity @s weapon.mainhand
item replace entity @e[tag=copy_all] weapon.offhand from entity @s weapon.offhand

item replace entity @e[tag=copy_all] armor.head from entity @s armor.head
item replace entity @e[tag=copy_all] armor.chest from entity @s armor.chest
item replace entity @e[tag=copy_all] armor.legs from entity @s armor.legs
item replace entity @e[tag=copy_all] armor.feet from entity @s armor.feet