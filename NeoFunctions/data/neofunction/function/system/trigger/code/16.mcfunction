# 命名：スキルRGB
# 説明：スキル選択画面表示【ブルー】
# >/function neofunction:system/trigger/code
# >/function neofunction:asset/skill/.setting/.macro
# >/trigger code set 63
# =/function neofunction:system/trigger/code/16


# 内容：
playsound minecraft:ui.button.click master @s ~ ~ ~ 1 0.9 1
advancement revoke @s only neofunction:tick/entity_scores/trigger/slot-blue
trigger slotB set 0
scoreboard players enable @s slotB

