      "entries": [
        {
          "type": "minecraft:item",
          "name": "minecraft:firework_star",
          "modifier": {
            "type": "minecraft:set_components",
            "components": {
              "minecraft:custom_name": {
                "text": "大統一銀貨【マモン】",
                "color": "dark_aqua",
                "bold": true,
                "italic": false,
                "underlined": true
              },
              "minecraft:lore": [
                {
                  "text": "多くの国家・種族間で広く流通している統一通貨",
                  "color": "gray",
                  "italic": false,
                  "underlined": true
                },
                [
                  {
                    "text": "かつての",
                    "color": "gray",
                    "bold": false,
                    "italic": false
                  },
                  {
                    "text": "聖騎士【パラディン】",
                    "color": "yellow"
                  },
                  {
                    "text": "が"
                  },
                  {
                    "text": "強欲の魔王【マモン】",
                    "color": "dark_blue"
                  },
                  {
                    "text": "を"
                  }
                ],
                {
                  "text": "封印した黄金十字架を加工して作られた硬貨。",
                  "color": "gray",
                  "bold": false,
                  "italic": false
                },
                {
                  "text": "コインとして数多に分割され弱体化しているが",
                  "color": "gray",
                  "bold": false,
                  "italic": false
                },
                {
                  "text": "列記とした上位悪魔の依代である。",
                  "color": "blue",
                  "bold": false,
                  "italic": false
                },
                [
                  {
                    "text": "「契約」",
                    "color": "red",
                    "bold": false,
                    "italic": false
                  },
                  {
                    "text": "に厳格で窃盗や詐欺があると",
                    "color": "gray"
                  }
                ],
                {
                  "text": "硬貨に宿る魔力が不履行者を呪い殺す。",
                  "color": "gray",
                  "bold": false,
                  "italic": false
                },
                {
                  "text": "また一箇所に貯蓄しすぎるとマモンが顕現してしまうため、",
                  "color": "gray",
                  "bold": false,
                  "italic": false
                },
                {
                  "text": "この富は独占されることなく健全に天下を回る貨幣として",
                  "color": "gray",
                  "bold": false,
                  "italic": false
                },
                {
                  "text": "この上ない価値をもつ通貨である。",
                  "color": "gray",
                  "bold": false,
                  "italic": false
                },
                {
                  "text": "まさに悪魔が保証した世界一安全な通貨。",
                  "color": "gray",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "「神は死後の復活を保証したが、魔王は現世の金貨を保証した。」",
                  "color": "black",
                  "bold": false,
                  "italic": false
                }
              ],
              "minecraft:enchantments": {
                "minecraft:mending": 1
              },
