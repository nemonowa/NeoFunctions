              "minecraft:lore": [
                {
                  "text": "茨には棘がある。",
                  "color": "#4A164F",
                  "italic": false
                },
                {
                  "text": "呪いには――",
                  "color": "#6E1B78",
                  "italic": false
                },
                {
                  "text": "その棘を、抜く術がない。",
                  "color": "#A42E8C",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "魔女が己の髪を編み込み、",
                  "color": "#68205F",
                  "italic": false
                },
                {
                  "text": "一本ごとに呪詛を縫い込んだ黒い鞭。",
                  "color": "#81266F",
                  "italic": false
                },
                {
                  "text": "振るうたび、呪いは獲物の中へ沈んでいく。",
                  "color": "#A02C83",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "代わりに、持ち主から何かを奪いながら。",
                  "color": "#C044A5",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "幸運か。",
                  "color": "#8E3D91",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "寿命か。",
                  "color": "#8E3D91",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "それとも、もっと大切な何かか.....",
                  "color": "#D58BCF",
                  "bold": true,
                  "italic": false
                }
              ],
