              "minecraft:lore": [
                {
                  "text": "影は、気配を残さない。",
                  "color": "#514A78",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "そして――影は、逃げ道すら残さない。",
                  "color": "#806FB5",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "月明かりを裂くように鍛えられた、極細の暗殺鞭。",
                  "color": "#5C5687",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "その一振りは音より速く、",
                  "color": "#7269A3",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "その持ち主は風よりも軽い。",
                  "color": "#9184C7",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "姿を捉えた時には、もう遅い。",
                  "color": "#A49AD1",
                  "bold": true,
                  "italic": false
                },
                {
                  "text": "影縫い。影に選ばれた者だけが、その名を知る。",
                  "color": "#655B96",
                  "bold": true,
                  "italic": false
                }
              ],
