                          }
                        ]
                      }
                    },
                    {
                      "text": "・効果時間\n",
                      "hover_event": {
                        "action": "show_text",
                        "value": [
                          {
                            "text": "30秒（スキルにより異なる）"
                          }
                        ]
                      }
                    },
                    {
                      "text": "・活用スキル\n",
                      "hover_event": {
                        "action": "show_text",
                        "value": [
                          {
                            "text": "運命連鎖・運命跳躍・運命旋律が刻印持ちの数や有無に応じて追加ダメージ／追加効果を発揮する"
                          }
